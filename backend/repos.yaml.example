repos:
  - name: "my-project"
    path: "/path/to/my-project"
    branch: "main"
  - name: "another-project"
    path: "/path/to/another-project"
    branch: "develop"

# Smart analysis configuration (all fields optional, shown with defaults)
smart_analysis:
  # Timezone for late-night and heatmap calculation
  # Supports: "UTC", "UTC+8", "UTC-5", "Asia/Shanghai", "America/New_York", etc.
  # Leave empty to use commit's local timestamp as-is
  timezone: "Asia/Shanghai"

  # Late-night time window (hour of day, 24h format)
  # Default: 23:00 to 05:00 next day
  late_night_start: 23
  late_night_end: 5

  # Heatmap color scheme: github | ocean | fire | purple | warm
  heatmap_scheme: "github"

  # Word cloud styling
  wordcloud:
    max_font_size: 80
    min_font_size: 10
    max_words: 100
    width: 1200
    height: 600
    # Matplotlib colormap: viridis | plasma | inferno | magma | cividis | coolwarm | Set2 | tab10
    colormap: "viridis"
    # Custom hex color list (overrides colormap when provided)
    # Words will be randomly colored from this list
    color_list:
      # - "#1a73e8"
      # - "#e8710a"
      # - "#0d652d"
      # - "#c5221f"
      # - "#9334e6"
    background_color: "white"
    prefer_horizontal: 0.7
    # Additional stopwords to filter out (beyond built-in English + Chinese list)
    custom_stopwords:
      # - "internal_tool_name"
      # - "project_prefix"
