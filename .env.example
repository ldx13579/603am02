# Git Habits Analyzer - Environment Configuration

# Redis
REDIS_URL=redis://localhost:6379/0

# Database
DATABASE_URL=sqlite:///./data/analysis.db

# YAML config path for repo definitions
REPOS_YAML_PATH=repos.yaml

# API Authentication
API_KEY=changeme-secret-key

# Rate Limiting (per IP)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Cache TTL for aggregate stats (seconds)
CACHE_TTL_SECONDS=300

# Database backup
DB_BACKUP_DIR=./data/backups
DB_BACKUP_KEEP_COUNT=7

# Docker-specific: host path to mount git repos (read-only)
# REPOS_MOUNT_PATH=/path/to/your/repos
